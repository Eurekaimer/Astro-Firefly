---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";

if (!siteConfig.pages.steam) {
	return Astro.redirect("/404/");
}

type SteamOwnedGame = {
	appid: number;
	name: string;
	playtime_forever?: number;
	playtime_2weeks?: number;
	img_icon_url?: string;
	rtime_last_played?: number;
};

type SteamOwnedGamesResponse = {
	response?: {
		game_count?: number;
		games?: SteamOwnedGame[];
	};
};

type SteamRecentlyPlayedResponse = {
	response?: {
		total_count?: number;
		games?: SteamOwnedGame[];
	};
};

type SteamGame = SteamOwnedGame & {
	playtime_forever: number;
	playtime_2weeks: number;
};

const buildTime = formatDateI18nWithTime(new Date());
const steamId = siteConfig.steam?.steamId?.trim() || "";
const steamApiKey = import.meta.env.STEAM_API_KEY?.trim() || "";
const recentLimit = siteConfig.steam?.recentLimit ?? 8;
const topLimit = siteConfig.steam?.topLimit ?? 12;
const apiBaseUrl = "https://api.steampowered.com/IPlayerService";

let games: SteamGame[] = [];
let recentGames: SteamGame[] = [];
let fetchStatus:
	| "ok"
	| "missing_config"
	| "missing_key"
	| "empty"
	| "failed" = "ok";

async function fetchSteamJson<T>(method: string, params: Record<string, string>) {
	const url = new URL(`${apiBaseUrl}/${method}/v0001/`);
	for (const [key, value] of Object.entries(params)) {
		url.searchParams.set(key, value);
	}
	url.searchParams.set("format", "json");

	const response = await fetch(url);
	if (!response.ok) {
		throw new Error(`Steam API ${method} failed with ${response.status}`);
	}

	return (await response.json()) as T;
}

if (!steamId) {
	fetchStatus = "missing_config";
} else if (!steamApiKey) {
	fetchStatus = "missing_key";
} else {
	try {
		const [ownedData, recentData] = await Promise.all([
			fetchSteamJson<SteamOwnedGamesResponse>("GetOwnedGames", {
				key: steamApiKey,
				steamid: steamId,
				include_appinfo: "true",
				include_played_free_games: "true",
			}),
			fetchSteamJson<SteamRecentlyPlayedResponse>("GetRecentlyPlayedGames", {
				key: steamApiKey,
				steamid: steamId,
				count: String(recentLimit),
			}),
		]);

		const recentByAppId = new Map<number, SteamOwnedGame>();
		for (const game of recentData.response?.games || []) {
			recentByAppId.set(game.appid, game);
		}

		games = (ownedData.response?.games || [])
			.map((game) => {
				const recentGame = recentByAppId.get(game.appid);
				return {
					...game,
					playtime_forever:
						recentGame?.playtime_forever ?? game.playtime_forever ?? 0,
					playtime_2weeks:
						recentGame?.playtime_2weeks ?? game.playtime_2weeks ?? 0,
					img_icon_url: game.img_icon_url || recentGame?.img_icon_url,
				};
			})
			.sort((a, b) => b.playtime_forever - a.playtime_forever);

		recentGames = games
			.filter((game) => game.playtime_2weeks > 0)
			.sort((a, b) => b.playtime_2weeks - a.playtime_2weeks)
			.slice(0, recentLimit);

		if (games.length === 0) {
			fetchStatus = "empty";
		}
	} catch (error) {
		console.error("[Steam] 获取数据失败:", error);
		fetchStatus = "failed";
	}
}

const playedGames = games.filter((game) => game.playtime_forever > 0);
const unplayedGames = games.filter((game) => game.playtime_forever === 0);
const totalPlayMinutes = games.reduce(
	(total, game) => total + game.playtime_forever,
	0,
);
const recentPlayMinutes = recentGames.reduce(
	(total, game) => total + game.playtime_2weeks,
	0,
);
const topGames = games.slice(0, topLimit);
const mostPlayedGame = playedGames[0];

function formatHours(minutes: number) {
	if (minutes <= 0) return "0 小时";
	const hours = minutes / 60;
	if (hours < 10) return `${hours.toFixed(1)} 小时`;
	return `${Math.round(hours)} 小时`;
}

function getGameCover(appid: number) {
	return `https://cdn.cloudflare.steamstatic.com/steam/apps/${appid}/header.jpg`;
}

function getGameIcon(game: SteamGame) {
	if (!game.img_icon_url) return "";
	return `https://media.steampowered.com/steamcommunity/public/images/apps/${game.appid}/${game.img_icon_url}.jpg`;
}

function getStoreUrl(appid: number) {
	return `https://store.steampowered.com/app/${appid}/`;
}

function getLastPlayedText(timestamp?: number) {
	if (!timestamp) return "暂无最近游玩";
	return new Date(timestamp * 1000).toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	});
}

const filters = [
	{ value: "all", label: "全部", count: games.length },
	{ value: "recent", label: "最近游玩", count: recentGames.length },
	{ value: "unplayed", label: "未游玩", count: unplayedGames.length },
].filter((filter) => filter.value === "all" || filter.count > 0);
---

<MainGridLayout title={i18n(I18nKey.steam)} description={i18n(I18nKey.steamDescription)}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">
			<div class="mb-6">
				<div class="flex items-center gap-3 mb-3">
					<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
						<Icon name="fa7-brands:steam" class="text-[1.3rem]" />
					</div>
					<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
						{i18n(I18nKey.steam)}
					</div>
				</div>
				<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
					{i18n(I18nKey.steamDescription)}
				</p>
				<p class="text-xs text-neutral-500 dark:text-neutral-500 mt-2">
					数据更新于 {buildTime}
				</p>
			</div>

			{fetchStatus === "ok" ? (
				<>
					<section class="steam-summary-grid mb-6">
						<div class="steam-stat">
							<span>游戏库</span>
							<strong>{games.length}</strong>
						</div>
						<div class="steam-stat">
							<span>总游戏时间</span>
							<strong>{formatHours(totalPlayMinutes)}</strong>
						</div>
						<div class="steam-stat">
							<span>近两周</span>
							<strong>{formatHours(recentPlayMinutes)}</strong>
						</div>
						<div class="steam-stat">
							<span>最常玩</span>
							<strong>{mostPlayedGame?.name || "暂无"}</strong>
						</div>
					</section>

					{recentGames.length > 0 && (
						<section class="mb-6">
							<div class="flex items-center gap-2 mb-3">
								<Icon name="material-symbols:schedule" class="text-(--primary) text-[1.25rem]" />
								<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 m-0">最近玩过</h2>
							</div>
							<div class="steam-recent-list">
								{recentGames.map((game) => (
									<a class="steam-recent-item" href={getStoreUrl(game.appid)} target="_blank" rel="noopener noreferrer nofollow">
										{getGameIcon(game) ? (
											<img src={getGameIcon(game)} alt="" loading="lazy" decoding="async" />
										) : (
											<span class="steam-icon-fallback">
												<Icon name="fa7-brands:steam" />
											</span>
										)}
										<span class="min-w-0">
											<span class="block truncate font-medium">{game.name}</span>
											<span class="block text-xs text-neutral-500 dark:text-neutral-400">{formatHours(game.playtime_2weeks)}</span>
										</span>
									</a>
								))}
							</div>
						</section>
					)}

					<section class="mb-5">
						<div class="flex items-center gap-2 mb-3">
							<Icon name="material-symbols:leaderboard" class="text-(--primary) text-[1.25rem]" />
							<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 m-0">最常玩游戏</h2>
						</div>
						<div class="steam-top-grid">
							{topGames.map((game, index) => (
								<a class="steam-top-item" href={getStoreUrl(game.appid)} target="_blank" rel="noopener noreferrer nofollow">
									<span class="steam-rank">#{index + 1}</span>
									<span class="truncate">{game.name}</span>
									<strong>{formatHours(game.playtime_forever)}</strong>
								</a>
							))}
						</div>
					</section>

					<div class="flex flex-wrap gap-1.5 mb-4">
						{filters.map((filter) => (
							<button
								class:list={[
									"px-3 py-1 rounded-full text-xs font-medium transition-all duration-200",
									{
										"bg-(--primary) text-white shadow-md": filter.value === "all",
										"bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover)": filter.value !== "all",
									},
								]}
								type="button"
								data-steam-filter={filter.value}
							>
								{filter.label}
								<span class="ml-1">({filter.count})</span>
							</button>
						))}
					</div>

					<div class="steam-game-grid">
						{games.map((game) => (
							<a
								class="steam-game-card"
								href={getStoreUrl(game.appid)}
								target="_blank"
								rel="noopener noreferrer nofollow"
								data-steam-game
								data-recent={game.playtime_2weeks > 0 ? "true" : "false"}
								data-unplayed={game.playtime_forever === 0 ? "true" : "false"}
							>
								<div class="steam-cover">
									<img src={getGameCover(game.appid)} alt={game.name} loading="lazy" decoding="async" />
									<div class="steam-cover-overlay" />
									<div class="steam-card-content">
										<h3>{game.name}</h3>
										<p>{formatHours(game.playtime_forever)}</p>
										{game.playtime_2weeks > 0 && (
											<span>近两周 {formatHours(game.playtime_2weeks)}</span>
										)}
									</div>
								</div>
								<div class="steam-card-meta">
									<span>{getLastPlayedText(game.rtime_last_played)}</span>
									<Icon name="material-symbols:open-in-new" class="text-[1rem]" />
								</div>
							</a>
						))}
					</div>
				</>
			) : (
				<div class="text-center py-16">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
						<Icon name={fetchStatus === "failed" ? "material-symbols:error-outline" : "material-symbols:settings"} class="text-[2rem] text-(--btn-content)" />
					</div>
					<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
						{fetchStatus === "missing_key"
							? "未配置 STEAM_API_KEY"
							: fetchStatus === "missing_config"
								? "未配置 Steam ID"
								: fetchStatus === "empty"
									? "暂无 Steam 数据"
									: "Steam 数据获取失败"}
					</h2>
					<p class="text-black/60 dark:text-white/60 mb-4 max-w-lg mx-auto">
						{fetchStatus === "missing_key"
							? "请在部署环境中添加 STEAM_API_KEY。密钥只会在构建时用于服务端请求，不会输出到前端。"
							: fetchStatus === "missing_config"
								? "请在 src/config/siteConfig.ts 中配置 steam.steamId。"
								: fetchStatus === "empty"
									? "可能是 Steam 个人资料或游戏库隐私设置限制了 API 读取。"
									: "可能是网络、Steam API 限制或隐私设置导致。页面会在下次构建时重新尝试。"}
					</p>
				</div>
			)}
		</div>
	</div>
</MainGridLayout>

<script>
	function initSteamFilters() {
		const buttons = document.querySelectorAll<HTMLButtonElement>("[data-steam-filter]");
		const games = document.querySelectorAll<HTMLElement>("[data-steam-game]");

		buttons.forEach((button) => {
			button.addEventListener("click", () => {
				const filter = button.dataset.steamFilter || "all";

				buttons.forEach((item) => {
					item.classList.remove("bg-(--primary)", "text-white", "shadow-md");
					item.classList.add("bg-(--btn-regular-bg)", "text-(--btn-content)", "hover:bg-(--btn-regular-bg-hover)");
				});
				button.classList.remove("bg-(--btn-regular-bg)", "text-(--btn-content)", "hover:bg-(--btn-regular-bg-hover)");
				button.classList.add("bg-(--primary)", "text-white", "shadow-md");

				games.forEach((game) => {
					const shouldShow =
						filter === "all" ||
						(filter === "recent" && game.dataset.recent === "true") ||
						(filter === "unplayed" && game.dataset.unplayed === "true");
					game.hidden = !shouldShow;
				});
			});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initSteamFilters);
	} else {
		initSteamFilters();
	}
</script>

<style>
	.steam-summary-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	@media (min-width: 768px) {
		.steam-summary-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.steam-stat,
	.steam-top-item,
	.steam-recent-item,
	.steam-game-card {
		border: 1px solid var(--line-divider);
		background: var(--card-bg);
	}

	.steam-stat {
		border-radius: 8px;
		padding: 0.85rem;
		min-width: 0;
	}

	.steam-stat span {
		display: block;
		color: var(--text-color-secondary);
		font-size: 0.75rem;
		margin-bottom: 0.25rem;
	}

	.steam-stat strong {
		display: block;
		color: var(--text-color);
		font-size: 1.15rem;
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.steam-recent-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 0.5rem;
	}

	.steam-recent-item {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
		border-radius: 8px;
		padding: 0.55rem;
		color: var(--text-color);
		text-decoration: none;
		transition: transform 0.15s ease, background-color 0.15s ease;
	}

	.steam-recent-item:hover,
	.steam-top-item:hover,
	.steam-game-card:hover {
		background: var(--btn-regular-bg-hover);
		transform: translateY(-1px);
	}

	.steam-recent-item img,
	.steam-icon-fallback {
		width: 32px;
		height: 32px;
		border-radius: 7px;
		flex: 0 0 auto;
	}

	.steam-icon-fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--btn-regular-bg);
	}

	.steam-top-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.5rem;
	}

	.steam-top-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 0.55rem;
		align-items: center;
		border-radius: 8px;
		padding: 0.6rem 0.7rem;
		color: var(--text-color);
		text-decoration: none;
		transition: transform 0.15s ease, background-color 0.15s ease;
	}

	.steam-rank {
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.steam-top-item strong {
		font-size: 0.82rem;
		color: var(--text-color-secondary);
	}

	.steam-game-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	@media (min-width: 640px) {
		.steam-game-grid {
			grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		}
	}

	.steam-game-card {
		display: block;
		overflow: hidden;
		border-radius: 8px;
		color: var(--text-color);
		text-decoration: none;
		transition: transform 0.15s ease, background-color 0.15s ease;
	}

	.steam-cover {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--btn-regular-bg);
	}

	.steam-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.steam-cover-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.76), rgba(0, 0, 0, 0.12) 68%, transparent);
	}

	.steam-card-content {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.7rem;
		color: white;
	}

	.steam-card-content h3 {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.25;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.steam-card-content p {
		margin: 0.25rem 0 0;
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.82);
	}

	.steam-card-content span {
		display: inline-block;
		margin-top: 0.35rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.18);
		padding: 0.15rem 0.45rem;
		font-size: 0.68rem;
		color: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
	}

	.steam-card-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.65rem;
		color: var(--text-color-secondary);
		font-size: 0.74rem;
	}
</style>
